{
	"name": "web",
	"packageManager": "pnpm@10.34.5",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.21.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.5",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@tiptap/core": "^3.35.0",
		"@tiptap/extension-link": "^3.35.0",
		"@tiptap/extension-placeholder": "^3.35.0",
		"@tiptap/pm": "^3.35.0",
		"@tiptap/starter-kit": "^3.35.0",
		"svelte-dnd-action": "^0.9.69",
		"tiptap-markdown": "^0.9.0"
	},
	"pnpm": {
		"comment": "Mirror of overrides in pnpm-workspace.yaml — read only by pnpm 9. See that file.",
		"overrides": {
			"markdown-it@<14.3.3": ">=14.3.3 <15",
			"linkify-it@<5.0.2": ">=5.0.2 <6",
			"cookie@<0.7.0": ">=0.7.0 <2",
			"brace-expansion@<5.0.12": ">=5.0.12",
			"postcss@<8.5.18": ">=8.5.18",
			"postcss-selector-parser@<7.1.6": ">=7.1.6",
			"source-map-js@<1.2.2": ">=1.2.2"
		}
	}
}
