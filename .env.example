# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://weld:weld@localhost:5432/weld
HOST=127.0.0.1
PORT=3000
JWT_SECRET=<random-64-char-hex>
SECURE_COOKIES=false                    # Set to true in production
FRONTEND_URL=http://localhost:5173      # SvelteKit dev server URL

# ── Research study ────────────────────────────────────────────────────────────
# Operator guide: paper/instrument/WELD_STUDY_RUNBOOK.md (tracked on the
# paper/tosm-journal-writing branch).
#
# Gates all research-study behavior. Off = normal product. When true: study
# provisioning/telemetry/agent endpoints active, GitHub writes locked down,
# frontend renders the study flow.
STUDY_MODE=false
# Study agent (OpenAI). Server-side only — never expose client-side. The agent
# endpoint degrades cleanly if unset, but the six agent tasks (T1–T6) then can't
# be done, so a real run REQUIRES this.
OPENAI_API_KEY=<sk-... from the OpenAI dashboard>
# Leave OPENAI_MODEL UNSET. The pinned snapshot is the config.rs default
# (gpt-5.4-2026-03-05) and is the string the paper's methods section names;
# setting this to anything else silently makes the paper wrong, and changing it
# mid-study is a confound. Verify the snapshot is still served before a run — a
# model too weak to use the C3 arm's wider context floors the condition the
# study is about.
# OPENAI_MODEL=
# Requires a valid, unused single-use access code to start, capping
# participation to one run per recruited person. Set true for a real run; leave
# false while testing locally so provisioning needs no code.
STUDY_REQUIRE_ACCESS_CODE=false
# Bearer token guarding BOTH data export and access-code minting. Unset = those
# endpoints 404. Treat it like an admin credential; set it directly on the
# deploy, never commit it.
STUDY_EXPORT_TOKEN=<long random secret>
# Also required for a real run: SECURE_COOKIES=true (needs HTTPS) and
# FRONTEND_URL pointing at the deployed study frontend.

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte (64 hex chars) master key used to encrypt GitHub user OAuth tokens at rest.
# Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=<random-64-char-hex>

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379        # (planned) Phase 3: Chat pub/sub

# ── GitHub App integration ────────────────────────────────────────────────────
# Create a GitHub App at https://github.com/settings/apps/new
# Callback URL (OAuth):  http://localhost:3000/api/v1/github/oauth/callback
# Setup URL (post-install redirect): http://localhost:3000/api/v1/github/setup
# Webhook URL: https://<your-ngrok>.ngrok.io/api/v1/github/webhook
#
# Required permissions: Issues r/w, Pull Requests r/w, Contents r, Metadata r
# Webhook events: issues, issue_comment, pull_request, pull_request_review, push, installation

GITHUB_APP_ID=<numeric app id from app settings page>
# Download the private key PEM from the app settings page, then base64-encode it:
#   base64 -w0 private-key.pem
GITHUB_APP_PRIVATE_KEY=<base64-encoded PEM>
GITHUB_WEBHOOK_SECRET=<random string matching the webhook secret set in GitHub App>
GITHUB_OAUTH_CLIENT_ID=<Ov23li... from app settings page>
GITHUB_OAUTH_CLIENT_SECRET=<generated client secret from app settings page>
GITHUB_APP_SLUG=<lowercase-slugified app name, e.g. weld-dev>

# ── File storage ──────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000       # (planned) MinIO for local dev
S3_ACCESS_KEY=weld
S3_SECRET_KEY=weld
S3_BUCKET=weld-files

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost                     # (planned) Email verification
SMTP_PORT=1025
