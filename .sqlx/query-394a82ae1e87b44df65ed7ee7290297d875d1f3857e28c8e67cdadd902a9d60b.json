  "query": "\n        UPDATE projects\n        SET name = $1,\n            description = $2,\n            github_repo = $3,\n            updated_at = NOW()\n        WHERE id = $4 AND deleted_at IS NULL\n        RETURNING id, team_id, name, slug, description, github_repo,\n                  created_at, updated_at, deleted_at\n        ",
