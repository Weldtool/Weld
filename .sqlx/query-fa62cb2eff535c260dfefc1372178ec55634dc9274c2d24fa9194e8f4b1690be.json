  "query": "\n        SELECT rt.user_id, u.role::text as \"role!\"\n        FROM refresh_tokens rt\n        JOIN users u ON u.id = rt.user_id\n        WHERE rt.token_hash = $1 AND rt.expires_at > NOW()\n        ",
