{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.name, t.slug, t.owner_id, t.created_at,\n               tm.role as \"role: TeamRole\"\n        FROM teams t\n        JOIN team_memberships tm ON tm.team_id = t.id\n        WHERE tm.user_id = $1 AND t.deleted_at IS NULL\n        ORDER BY t.created_at ASC\n        ",
