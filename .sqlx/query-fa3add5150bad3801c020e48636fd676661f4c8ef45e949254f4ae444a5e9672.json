{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.short_id, t.title, t.project_id, t.github_pr_id\n        FROM tasks t\n        JOIN projects p ON p.id = t.project_id\n        WHERE p.team_id = $1\n          AND p.deleted_at IS NULL\n          AND t.deleted_at IS NULL\n        ORDER BY t.short_id DESC\n        ",
