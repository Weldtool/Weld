  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.email, u.display_name, u.avatar_url,\n               tm.role as \"role: TeamRole\",\n               tm.joined_at\n        FROM team_memberships tm\n        JOIN users u ON u.id = tm.user_id\n        WHERE tm.team_id = $1 AND tm.user_id = $2\n        ",
